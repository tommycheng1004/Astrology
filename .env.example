# 複製成 .env.local 後填入。.env.local 不會進版控，金鑰絕對不要寫進程式碼或貼到別處。

# 正式網址（sitemap、canonical、分享圖用）
# NEXT_PUBLIC_SITE_URL=https://example.com

# ── 會員（Firebase）── 設定步驟見 docs/firebase-setup.md；四個 NEXT_PUBLIC_ 值都有才會出現登入按鈕
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=你的專案.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# 服務帳戶（只在伺服器使用，用於會員報告、行事曆、事件定盤、建議問題快取與 AI 每日題數）。私鑰整段貼上，換行寫成 \n 也可以
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# AI 每日題數（預設訪客 2 題、會員 10 題）
# AI_DAILY_GUEST=2
# AI_DAILY_MEMBER=10
# 管理後台（/admin）的擁有者 Email，逗號分隔。必須是已驗證的 Email（建議用 Google 登入）。其他後台人員由擁有者在後台指派
# ADMIN_OWNER_EMAILS=you@example.com
# 本機用模擬器開發時才設定（正式環境絕對不要設）
# NEXT_PUBLIC_FIREBASE_EMULATOR=1
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# 隱私權政策頁的聯絡信箱（選填，沒設就不顯示）
# NEXT_PUBLIC_CONTACT_EMAIL=

# GA4 評估 ID（G- 開頭，選填；沒設就完全不載入分析程式）。設定步驟見 docs/analytics.md
# NEXT_PUBLIC_GA_ID=

# AI 問答：設為 1 才會開啟（同時控制前端分頁與 /api/ask 端點）
NEXT_PUBLIC_AI_ENABLED=1
# Gemini API 金鑰（https://aistudio.google.com 取得），只在伺服器端使用。
# 注意：免費額度的資料會被 Google 用來改進產品；正式上線前請在 Google AI Studio 啟用付費（帳單），付費方案不會。
GEMINI_API_KEY=
# 主要模型，預設 gemini-3.5-flash-lite
# AI_MODEL=gemini-3.5-flash-lite
# 備援模型（逗號分隔）：主要模型忙碌（503）、額度用完（429）或逾時，依序改用。
# 免費方案每個模型的額度分開算，換模型通常就能成功。預設 gemini-3.6-flash,gemini-3.5-flash；設成空字串可關閉
# AI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
