# 複製成 .env.local 後填入。.env.local 不會進版控，金鑰絕對不要寫進程式碼或貼到別處。

# 正式網址（sitemap、canonical、分享圖用）
# NEXT_PUBLIC_SITE_URL=https://example.com

# ── 會員（Firebase）── 設定步驟見 docs/firebase-setup.md；四個 NEXT_PUBLIC_ 值都有才會出現登入按鈕
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=你的專案.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# 服務帳戶（只在伺服器使用，用來記錄 AI 每日題數）。私鑰整段貼上，換行寫成 \n 也可以
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# AI 每日題數（預設訪客 2 題、會員 10 題）
# AI_DAILY_GUEST=2
# AI_DAILY_MEMBER=10
# 本機用模擬器開發時才設定（正式環境絕對不要設）
# NEXT_PUBLIC_FIREBASE_EMULATOR=1
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# 隱私權政策頁的聯絡信箱（選填，沒設就不顯示）
# NEXT_PUBLIC_CONTACT_EMAIL=

# AI 問答：設為 1 才會開啟（同時控制前端分頁與 /api/ask 端點）
NEXT_PUBLIC_AI_ENABLED=1
# Gemini API 金鑰（https://aistudio.google.com 取得），只在伺服器端使用。
# 注意：免費額度的資料會被 Google 用來改進產品；正式上線前請在 Google AI Studio 啟用付費（帳單），付費方案不會。
GEMINI_API_KEY=
# 使用的模型，預設 gemini-3.5-flash-lite；要更好的回答品質可改 gemini-3.8-flash
# AI_MODEL=gemini-3.5-flash-lite
