# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Firebase：模擬器紀錄與服務帳戶金鑰（金鑰只放 .env.local 與 Netlify 環境變數）
firebase-debug.log
firestore-debug.log
*-firebase-adminsdk-*.json
service-account*.json

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 字型子集的原始字型（npm run font:subset 會自動下載）
/fonts-src/
